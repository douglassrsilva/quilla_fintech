DATABRICKS_BUNDLE_VAR_schema=REPLACE_ME
DATABRICKS_BUNDLE_VAR_bronze_schema=REPLACE_ME
DATABRICKS_BUNDLE_VAR_silver_schema=REPLACE_ME
DATABRICKS_BUNDLE_VAR_gold_schema=REPLACE_ME
DATABRICKS_BUNDLE_VAR_governance_schema=REPLACE_ME
DATABRICKS_BUNDLE_VAR_monitoring_schema=REPLACE_ME
DATABRICKS_BUNDLE_VAR_ml_schema=REPLACE_ME
DATABRICKS_BUNDLE_VAR_ai_schema=REPLACE_ME
DATABRICKS_BUNDLE_VAR_volume=REPLACE_ME
DATABRICKS_BUNDLE_VAR_ml_volume=REPLACE_ME
DATABRICKS_BUNDLE_VAR_sql_warehouse_id=REPLACE_ME
DATABRICKS_BUNDLE_VAR_zerobus_endpoint=REPLACE_ME
DATABRICKS_BUNDLE_VAR_lakebase_database_resource_id=REPLACE_ME
DATABRICKS_BUNDLE_VAR_lakebase_owner_role=REPLACE_ME

