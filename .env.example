# Todos los recursos principales tienen valores portátiles por defecto y son
# creados por el bundle. Copie este archivo solamente si necesita sobrescribir
# nombres para evitar colisiones en un workspace compartido.
#
# cp .env.example .env.local
# set -a && source .env.local && set +a

# DATABRICKS_BUNDLE_VAR_catalog=mi_usuario_quilla_demo
# DATABRICKS_BUNDLE_VAR_lakebase_project=mi-usuario-quilla-ltap
# DATABRICKS_BUNDLE_VAR_vector_search_endpoint=mi-usuario-quilla-ai-search

# Zerobus es opcional para el deploy. Complete el endpoint regional únicamente
# antes de ejecutar el simulador realtime.
DATABRICKS_BUNDLE_VAR_zerobus_endpoint=

# Helpers opcionales usados por validadores locales después del deploy.
# QUILLA_APP_URL=https://<app>.databricksapps.com
# QUILLA_WORKSPACE_HOST=https://<workspace>.cloud.databricks.com
