{
  "datasets": [
    {
      "name": "growth_kpis",
      "displayName": "growth_kpis",
      "queryLines": [
        "\nSELECT MEASURE(revenue_usd_90d) AS revenue_usd,\n  MEASURE(contribution_margin_usd_90d) AS margin_usd,\n  100 * MEASURE(contribution_margin_rate) AS margin_rate_pct,\n  100 * MEASURE(conversion_rate) AS conversion_rate_pct,\n  100 * MEASURE(churn_rate) AS churn_rate_pct,\n  MEASURE(weighted_average_clv_usd_12m) AS average_clv_usd\nFROM example_catalog.example_gold.metrics_growth_customer\n"
      ]
    },
    {
      "name": "growth_month",
      "displayName": "growth_month",
      "queryLines": [
        "\nSELECT observation_month AS month, 'Receita 90d' AS series, MEASURE(revenue_usd_90d) AS value\nFROM example_catalog.example_gold.metrics_growth_customer GROUP BY ALL\nUNION ALL\nSELECT observation_month, 'Margem 90d', MEASURE(contribution_margin_usd_90d)\nFROM example_catalog.example_gold.metrics_growth_customer GROUP BY ALL\n"
      ]
    },
    {
      "name": "growth_country",
      "displayName": "growth_country",
      "queryLines": [
        "\nSELECT country_code,\n  MEASURE(revenue_usd_90d) AS revenue_usd,\n  MEASURE(contribution_margin_usd_90d) AS margin_usd,\n  100 * MEASURE(conversion_rate) AS conversion_rate_pct,\n  100 * MEASURE(churn_rate) AS churn_rate_pct,\n  MEASURE(weighted_average_clv_usd_12m) AS average_clv_usd\nFROM example_catalog.example_gold.metrics_growth_customer GROUP BY country_code\n"
      ]
    },
    {
      "name": "pricing_offer",
      "displayName": "pricing_offer",
      "queryLines": [
        "\nSELECT offer_type,\n  MEASURE(offers) AS offers,\n  100 * MEASURE(acceptance_rate) AS acceptance_rate_pct,\n  MEASURE(revenue_usd_90d) AS revenue_usd,\n  MEASURE(contribution_margin_usd_90d) AS margin_usd\nFROM example_catalog.example_gold.metrics_pricing_profitability GROUP BY offer_type\n"
      ]
    },
    {
      "name": "pricing_country",
      "displayName": "pricing_country",
      "queryLines": [
        "\nSELECT country_code,\n  100 * MEASURE(acceptance_rate) AS acceptance_rate_pct,\n  MEASURE(weighted_average_offered_apr_bps) / 100 AS offered_apr_pct,\n  MEASURE(contribution_margin_usd_90d) AS margin_usd,\n  100 * MEASURE(risk_adjusted_margin_rate) AS risk_adjusted_margin_pct\nFROM example_catalog.example_gold.metrics_pricing_profitability GROUP BY country_code\n"
      ]
    }
  ],
