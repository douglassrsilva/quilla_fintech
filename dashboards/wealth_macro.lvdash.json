{
  "datasets": [
    {
      "name": "wealth_kpis",
      "displayName": "wealth_kpis",
      "queryLines": [
        "\nSELECT MEASURE(investment_volume_usd) AS investment_volume_usd,\n  100 * MEASURE(recommendation_acceptance_rate) AS recommendation_acceptance_pct,\n  100 * MEASURE(suitability_breach_rate) AS suitability_breach_pct,\n  MEASURE(weighted_average_portfolio_value_usd) AS average_portfolio_value_usd\nFROM example_catalog.example_gold.metrics_wealth_engagement\n"
      ]
    },
    {
      "name": "suitability_kpis",
      "displayName": "suitability_kpis",
      "queryLines": [
        "\nSELECT MEASURE(profiles) AS profiles,\n  100 * MEASURE(eligibility_rate) AS eligibility_rate_pct,\n  MEASURE(restricted_profiles) AS restricted_profiles,\n  MEASURE(investable_assets_usd) AS investable_assets_usd\nFROM example_catalog.example_gold.metrics_investor_suitability\n"
      ]
    },
    {
      "name": "wealth_asset",
      "displayName": "wealth_asset",
      "queryLines": [
        "\nSELECT asset_class,\n  MEASURE(investment_volume_usd) AS investment_volume_usd,\n  100 * MEASURE(recommendation_acceptance_rate) AS recommendation_acceptance_pct,\n  100 * MEASURE(suitability_breach_rate) AS suitability_breach_pct\nFROM example_catalog.example_gold.metrics_wealth_engagement GROUP BY asset_class\n"
      ]
    },
    {
      "name": "wealth_month",
      "displayName": "wealth_month",
      "queryLines": [
        "\nSELECT DATE_TRUNC('MONTH', event_date) AS month, 'Compras' AS series, MEASURE(buy_volume_usd) AS value\nFROM example_catalog.example_gold.metrics_wealth_engagement GROUP BY ALL\nUNION ALL\nSELECT DATE_TRUNC('MONTH', event_date), 'Vendas', MEASURE(sell_volume_usd)\nFROM example_catalog.example_gold.metrics_wealth_engagement GROUP BY ALL\n"
      ]
    },
    {
      "name": "suitability_objective",
      "displayName": "suitability_objective",
      "queryLines": [
        "\nSELECT investment_objective, MEASURE(profiles) AS profiles,\n  100 * MEASURE(eligibility_rate) AS eligibility_rate_pct,\n  MEASURE(average_loss_capacity_pct) AS average_loss_capacity_pct\nFROM example_catalog.example_gold.metrics_investor_suitability GROUP BY investment_objective\n"
      ]
    },
    {
      "name": "macro_latest",
      "displayName": "macro_latest",
      "queryLines": [
        "\nSELECT country_code, stress_regime,\n  MEASURE(average_policy_rate_pct) AS policy_rate_pct,\n  MEASURE(average_inflation_yoy_pct) AS inflation_yoy_pct,\n  MEASURE(average_unemployment_pct) AS unemployment_pct,\n  MEASURE(average_gdp_nowcast_yoy_pct) AS gdp_nowcast_yoy_pct,\n  MEASURE(average_energy_price_index) AS energy_price_index\nFROM example_catalog.example_gold.metrics_macro_stress\nWHERE observation_date = (SELECT MAX(observation_date) FROM example_catalog.example_ml.source_macroeconomic_daily)\nGROUP BY ALL\n"
      ]
    },
    {
      "name": "macro_trend",
      "displayName": "macro_trend",
      "queryLines": [
        "\nSELECT DATE_TRUNC('MONTH', observation_date) AS month, 'Inflação YoY' AS series,\n  MEASURE(average_inflation_yoy_pct) AS value\nFROM example_catalog.example_gold.metrics_macro_stress GROUP BY ALL\nUNION ALL\nSELECT DATE_TRUNC('MONTH', observation_date), 'Taxa básica', MEASURE(average_policy_rate_pct)\nFROM example_catalog.example_gold.metrics_macro_stress GROUP BY ALL\n"
      ]
    }
  ],
