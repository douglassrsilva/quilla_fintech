{
  "datasets": [
    {
      "name": "exec_kpis",
      "displayName": "exec_kpis",
      "queryLines": [
        "\nSELECT\n  MEASURE(gross_volume_usd) AS gross_volume_usd,\n  MEASURE(total_events) AS total_events,\n  100 * MEASURE(completion_rate) AS completion_rate_pct,\n  100 * MEASURE(fraud_rate) AS fraud_rate_pct,\n  MEASURE(net_flow_usd) AS net_flow_usd,\n  MEASURE(cross_border_volume_usd) AS cross_border_volume_usd\nFROM example_catalog.example_gold.metrics_financial_performance\n"
      ]
    },
    {
      "name": "exec_country",
      "displayName": "exec_country",
      "queryLines": [
        "\nSELECT country_code,\n  MEASURE(gross_volume_usd) AS gross_volume_usd,\n  100 * MEASURE(completion_rate) AS completion_rate_pct,\n  100 * MEASURE(fraud_rate) AS fraud_rate_pct\nFROM example_catalog.example_gold.metrics_financial_performance\nGROUP BY country_code\n"
      ]
    },
    {
      "name": "exec_month",
      "displayName": "exec_month",
      "queryLines": [
        "\nSELECT DATE_TRUNC('MONTH', event_date) AS month,\n  'Volume USD' AS series, MEASURE(gross_volume_usd) AS value\nFROM example_catalog.example_gold.metrics_financial_performance GROUP BY ALL\nUNION ALL\nSELECT DATE_TRUNC('MONTH', event_date), 'Fluxo líquido USD', MEASURE(net_flow_usd)\nFROM example_catalog.example_gold.metrics_financial_performance GROUP BY ALL\n"
      ]
    },
    {
      "name": "exec_credit",
      "displayName": "exec_credit",
      "queryLines": [
        "\nSELECT country_code,\n  100 * MEASURE(approval_rate) AS approval_rate_pct,\n  MEASURE(applications) AS applications,\n  MEASURE(approved_amount_local) AS approved_amount_local\nFROM example_catalog.example_gold.metrics_credit_portfolio GROUP BY country_code\n"
      ]
    },
    {
      "name": "exec_risk",
      "displayName": "exec_risk",
      "queryLines": [
        "\nSELECT country_code,\n  MEASURE(total_alerts) AS total_alerts,\n  100 * MEASURE(confirmation_rate) AS confirmation_rate_pct,\n  100 * MEASURE(false_positive_rate) AS false_positive_rate_pct\nFROM example_catalog.example_gold.metrics_risk_operations GROUP BY country_code\n"
      ]
    },
    {
      "name": "exec_freshness",
      "displayName": "exec_freshness",
      "queryLines": [
        "\nSELECT MAX(event_date) AS max_event_date,\n  SUM(CASE WHEN event_date = (SELECT MAX(event_date) FROM example_catalog.example_gold.mv_financial_performance_daily)\n      THEN event_count ELSE 0 END) AS latest_day_events\nFROM example_catalog.example_gold.mv_financial_performance_daily\n"
      ]
    },
    {
      "name": "exec_quality",
      "displayName": "exec_quality",
      "queryLines": [
        "\nSELECT 100 * MEASURE(reconciliation_rate) AS reconciliation_rate_pct,\n  100 * MEASURE(global_acceptance_rate) AS acceptance_rate_pct,\n  MEASURE(quarantine_rows) AS quarantine_rows\nFROM example_catalog.example_gold.metrics_data_quality\n"
      ]
    }
  ],
