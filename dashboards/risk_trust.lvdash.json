{
  "datasets": [
    {
      "name": "risk_kpis",
      "displayName": "risk_kpis",
      "queryLines": [
        "\nSELECT MEASURE(total_alerts) AS total_alerts,\n  100 * MEASURE(confirmation_rate) AS confirmation_rate_pct,\n  100 * MEASURE(false_positive_rate) AS false_positive_rate_pct\nFROM example_catalog.example_gold.metrics_risk_operations\n"
      ]
    },
    {
      "name": "case_kpis",
      "displayName": "case_kpis",
      "queryLines": [
        "\nSELECT MEASURE(prevented_loss_usd) AS prevented_loss_usd,\n  MEASURE(net_loss_usd) AS net_loss_usd,\n  MEASURE(weighted_average_resolution_minutes) AS resolution_minutes\nFROM example_catalog.example_gold.metrics_case_outcomes\n"
      ]
    },
    {
      "name": "dq_kpis",
      "displayName": "dq_kpis",
      "queryLines": [
        "\nSELECT 100 * MEASURE(reconciliation_rate) AS reconciliation_rate_pct,\n  100 * MEASURE(global_acceptance_rate) AS acceptance_rate_pct,\n  MEASURE(quarantine_rows) AS quarantine_rows\nFROM example_catalog.example_gold.metrics_data_quality\n"
      ]
    },
    {
      "name": "risk_country",
      "displayName": "risk_country",
      "queryLines": [
        "\nSELECT country_code,\n  MEASURE(total_alerts) AS total_alerts,\n  100 * MEASURE(confirmation_rate) AS confirmation_rate_pct,\n  100 * MEASURE(false_positive_rate) AS false_positive_rate_pct\nFROM example_catalog.example_gold.metrics_risk_operations GROUP BY country_code\n"
      ]
    },
    {
      "name": "risk_trend",
      "displayName": "risk_trend",
      "queryLines": [
        "\nSELECT alert_date, severity, MEASURE(total_alerts) AS total_alerts\nFROM example_catalog.example_gold.metrics_risk_operations GROUP BY alert_date, severity\n"
      ]
    },
    {
      "name": "case_domain",
      "displayName": "case_domain",
      "queryLines": [
        "\nSELECT domain,\n  MEASURE(cases) AS cases,\n  MEASURE(prevented_loss_usd) AS prevented_loss_usd,\n  MEASURE(net_loss_usd) AS net_loss_usd,\n  100 * MEASURE(confirmation_rate) AS confirmation_rate_pct\nFROM example_catalog.example_gold.metrics_case_outcomes GROUP BY domain\n"
      ]
    },
    {
      "name": "credit_country",
      "displayName": "credit_country",
      "queryLines": [
        "\nSELECT country_code,\n  MEASURE(applications) AS applications,\n  100 * MEASURE(approval_rate) AS approval_rate_pct,\n  MEASURE(weighted_average_annual_rate_bps) / 100 AS annual_rate_pct,\n  MEASURE(weighted_average_risk_score) AS risk_score\nFROM example_catalog.example_gold.metrics_credit_portfolio GROUP BY country_code\n"
      ]
    },
    {
      "name": "dq_detail",
      "displayName": "dq_detail",
      "queryLines": [
        "\nSELECT dataset_name,\n  MEASURE(bronze_rows) AS bronze_rows,\n  MEASURE(silver_rows) AS silver_rows,\n  MEASURE(quarantine_rows) AS quarantine_rows,\n  100 * MEASURE(global_acceptance_rate) AS acceptance_rate_pct,\n  100 * MEASURE(reconciliation_rate) AS reconciliation_rate_pct\nFROM example_catalog.example_gold.metrics_data_quality GROUP BY dataset_name\n"
      ]
    }
  ],
